{
  "name": "monetization-mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A pay-per-call MCP server (x402 'vending machine') that charges other AI agents in USDC to use Solana MEV/arbitrage and Apify scraping tools.",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "x402",
    "mcp",
    "model-context-protocol",
    "payments",
    "usdc",
    "solana",
    "mev",
    "apify",
    "monetization"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@x402/core": "^2.14.0",
    "@x402/evm": "^2.14.0",
    "@x402/express": "^2.14.0",
    "@x402/mcp": "^2.14.0",
    "@x402/svm": "^2.14.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
