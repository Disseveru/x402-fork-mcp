# =============================================================================
# monetization-mcp-server  —  environment template
# =============================================================================
# HOW TO USE:
#   1. Copy this file to ".env"   (command: cp .env.example .env)
#   2. Fill in the values below.
#   3. Save. The server reads this file automatically on startup.
#
# !!!  SECURITY — READ THIS  !!!
# You are the SELLER (the "vending machine"). To RECEIVE money you only need
# your PUBLIC wallet ADDRESS. You must NEVER put a PRIVATE KEY / seed phrase in
# this server's .env file. A private key is only ever needed by the BUYER (the
# paying agent). Anyone who gets a private key can drain that wallet. If a guide
# ever tells you to paste EVM_PRIVATE_KEY / SVM_PRIVATE_KEY into a *server*,
# ignore it — that is unsafe. This server is intentionally built to use public
# addresses only.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. WHERE YOUR MONEY GOES  (set at least ONE of these public addresses)
# -----------------------------------------------------------------------------
# Your EVM (Base) public address that will receive USDC. Starts with "0x".
EVM_ADDRESS=

# Your Solana (SVM) public address that will receive USDC. Base58 string.
SVM_ADDRESS=


# -----------------------------------------------------------------------------
# 2. NETWORK + FACILITATOR  (defaults are safe TESTNETS — no real money)
# -----------------------------------------------------------------------------
# CAIP-2 network IDs. Defaults below are TEST networks so you can try it for free.
#   Base Sepolia (test):    eip155:84532
#   Base Mainnet (real $):  eip155:8453
EVM_NETWORK=eip155:84532

#   Solana Devnet (test):   solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
#   Solana Mainnet (real$): solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
SVM_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1

# The x402 facilitator verifies + settles payments on-chain for you.
# The public facilitator works with the testnet defaults above.
FACILITATOR_URL=https://x402.org/facilitator


# -----------------------------------------------------------------------------
# 3. PRICING  (what each tool call costs the paying agent)
# -----------------------------------------------------------------------------
SOLANA_FEED_PRICE=$0.05
APIFY_SCRAPER_PRICE=$0.10


# -----------------------------------------------------------------------------
# 4. TOOL API KEYS  (optional — leave blank to run in safe DEMO/mock mode)
# -----------------------------------------------------------------------------
# Solana RPC endpoint used by the MEV/arbitrage feed tool.
# Get a free one from Helius/QuickNode/Alchemy, or use the public default.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Apify API token used by the social-media scraper tool.
# Get it from https://console.apify.com/account/integrations
# If left blank, the scraper tool returns clearly-labelled mock data.
APIFY_TOKEN=


# -----------------------------------------------------------------------------
# 5. SERVER
# -----------------------------------------------------------------------------
PORT=4022
# Public base URL where this server is reachable (used in logs + receipts).
# On Replit/ngrok paste the https URL they give you.
PUBLIC_BASE_URL=http://localhost:4022
